# Database & Queue
DATABASE_URL=postgres://studio:studio_dev@127.0.0.1:5432/techcontent
REDIS_URL=redis://127.0.0.1:6379
REDIS_HEALTH_CHECK=false
STUDIO_GENERATION_ENABLED=false
# STUDIO_GENERATION_CONFIG contains operation credit prices, provider request ceilings and environment-wide caps.
STUDIO_GENERATION_CONFIG=
STUDIO_CREDIT_PLANS=
STUDIO_TRIALS_ENABLED=false
STUDIO_TRIALS_CONFIG=
API_PORT=4000

# Clerk authentication. Development defaults to the loopback-only legacy Studio.
# SOCIALSTUDIO_AUTH=clerk
# Set hosted portfolio (public demo only, protected APIs closed) or hosted staging explicitly.
# SOCIALSTUDIO_DEPLOYMENT=portfolio
# SOCIALSTUDIO_DEPLOYMENT=staging
FRONTEND_URL=http://127.0.0.1:5173
MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
OWNER_EMAIL=owner@example.com
OWNER_CLERK_USER_ID=
OWNER_REQUIRE_MFA=false
# Production access to existing owner projects requires an explicit dual-instance identity check.
# OWNER_PRIOR_CLERK_USER_ID=
# OWNER_GOOGLE_SUBJECT_HASH=
STUDIO_PRODUCTION_OWNER_ADMIN_ENABLED=false

# Public demo. Stage verified exports locally with npm run demo:prepare, or configure a public HTTPS media prefix.
# DEMO_MEDIA_DIR=media/demo
DEMO_PUBLIC_BASE_URL=
# Cloudinary uses distinct image and video delivery prefixes.
DEMO_PUBLIC_VIDEO_BASE_URL=
DEMO_PUBLIC_IMAGE_BASE_URL=

# Private media is optional. Use cloudinary for hosted media or local for development.
PRIVATE_MEDIA_DRIVER=
PRIVATE_MEDIA_SIGNING_KEY=
# PRIVATE_MEDIA_DIR=media/private
# PRIVATE_MEDIA_TEMP_HOURS=24
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_PRIVATE_PREFIX=socialstudio-private
# CLOUDINARY_MAX_IMAGE_UPLOAD_BYTES=10000000
# CLOUDINARY_MAX_VIDEO_UPLOAD_BYTES=100000000
# The usage command accepts an Admin API credential or OAuth token in its operator environment.
# CLOUDINARY_USAGE_WARN_PERCENT=80

# Inactive R2 settings, retained for reference.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=
# R2_DEMO_BUCKET=

# Razorpay test checkout only. Leave disabled until scoped test keys are configured.
RAZORPAY_TEST_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_PLAN_PAISA=
RAZORPAY_TEST_PLAN_CREDITS=

# Set VITE_CLERK_PUBLISHABLE_KEY and VITE_API_URL in dashboard/.env.local or in Vercel.
# The VITE_ publishable key is public. Keep CLERK_SECRET_KEY on the backend.

# LLM Providers (gemini | groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Video director defaults to Groq GPT-OSS 120B independently of script generation.
# REEL_DIRECTOR_PROVIDER=groq
# REEL_DIRECTOR_MODEL=openai/gpt-oss-120b
# Optional scene-planner overrides. Gemini or Groq can back up the other when both keys are set.
# REEL_PREMIUM_DIRECTOR_PROVIDER=gemini
# REEL_PREMIUM_DIRECTOR_MODEL=gemini-2.5-flash
# Provider-specific visual director models, independent of script generation.
# REEL_GEMINI_DIRECTOR_MODEL=gemini-2.5-pro
# REEL_GROQ_DIRECTOR_MODEL=openai/gpt-oss-120b
# Semantic visual planning uses independently configurable provider/model pairs.
# REEL_CREATIVE_DIRECTOR_PROVIDER=groq
# REEL_CREATIVE_DIRECTOR_MODEL=openai/gpt-oss-120b
# REEL_SCENE_ENGINEER_PROVIDER=groq
# REEL_SCENE_ENGINEER_MODEL=openai/gpt-oss-120b
# REEL_GROQ_VISUAL_TPM=8000
# REEL_VISUAL_PLANNER=legacy
# Optional cinematic artwork for real-world scenes. Technical diagrams still use Remotion.
REEL_IMAGE_GENERATION=off
REEL_IMAGE_PROVIDER=gemini
REEL_IMAGE_MODEL=gemini-3.1-flash-image
# Optional multimodal review. Sends scene narration and rendered stills to Google.
# REEL_VISUAL_REVIEW_MODEL=
# Optional approved local artwork catalog.
# REEL_APPROVED_ASSET_DIR=media/approved-reel-assets
# REMOTION_PRIVATE_LICENSE_KEY=
# REMOTION_PRODUCTION_RENDER=false
# Cloudflare artwork uses Workers AI FLUX.2 Klein 4B with a scoped API token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# TTS Providers (edge | elevenlabs)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=hi-IN-MadhurNeural
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Security & Executables
AUTOMATION_TOKEN=
CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
